# Set to "true" to use the in-memory mock backend (no Apps Script needed).
# Useful for local UI development and design review.
VITE_USE_MOCK_API=false

# The deployed Google Apps Script Web App URL (ends in /exec).
# See backend/Code.gs and backend/DEPLOY.md for how to get this.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxE9DhkdWfHZfTqEf3FSuLlAkIgSxeLD80vwyEzVCOvJ7VhSw5Z9Ptfvgwd7kRVTWW5/exec

# Optional shared secret also set as CLIENT_TOKEN in the Apps Script
# project's Script Properties. Adds a light check beyond rate limiting;
# do not treat it as strong auth since it ships in the frontend bundle.
VITE_CLIENT_TOKEN=

# WhatsApp number for the "Hubungi Admin" button, digits only with
# country code, no leading +. e.g. 62812xxxxxxx
VITE_ADMIN_WHATSAPP=6285600847046
